# syntax=docker/dockerfile:1.7
#
# Imagen del TABLERO — el visor Streamlit sobre salidas*/.
#
# Es deliberadamente independiente de la imagen del pipeline: el visor no
# necesita lightgbm ni scipy (solo lee CSVs y JSONs), y mantenerlo aparte
# garantiza que nada de lo que se instale para visualizar pueda alterar el
# entorno que produce los números de la tesis (RN-5).

FROM python:3.13-slim

WORKDIR /repo/motor-pronostico-novapack

# El repositorio se monta en /repo COMO SOLO LECTURA: el tablero no puede
# escribir ni un byte dentro del proyecto. Streamlit necesita un HOME escribible
# para su configuración y caché, así que se lo manda a /tmp.
ENV HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_FILE_WATCHER_TYPE=poll \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

COPY requirements-tablero.txt /tmp/requirements-tablero.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements-tablero.txt

EXPOSE 8501

CMD ["streamlit", "run", "tablero/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
